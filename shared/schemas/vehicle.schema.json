{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aerorl:schema:vehicle:v1",
  "title": "AeroRL vehicle v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "simulator_id": {
      "type": "string",
      "const": "quadrotor-rk4-v1"
    },
    "controller_id": {
      "type": "string",
      "const": "rate-p-v1"
    },
    "world_frame": {
      "type": "string",
      "const": "right-handed-z-up"
    },
    "body_frame": {
      "type": "string",
      "const": "x-forward-y-left-z-up"
    },
    "quaternion_order": {
      "type": "string",
      "const": "wxyz"
    },
    "mass_kg": {
      "type": "number",
      "minimum": 5e-324
    },
    "gravity_mps2": {
      "type": "number",
      "minimum": 5e-324
    },
    "inertia_kgm2": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 5e-324
      },
      "minItems": 3,
      "maxItems": 3
