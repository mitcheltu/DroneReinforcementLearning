    "gravity_mps2",
    "inertia_kgm2",
    "arm_length_m",
    "rotor_max_thrust_n",
    "motor_time_constant_s",
    "linear_drag_kgps",
    "reaction_torque_per_thrust_m",
    "rate_gains",
