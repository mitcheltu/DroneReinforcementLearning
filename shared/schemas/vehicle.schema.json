    "arm_length_m": {
      "type": "number",
      "minimum": 5e-324
    },
    "rotor_max_thrust_n": {
      "type": "number",
      "minimum": 5e-324
    },
    "motor_time_constant_s": {
      "type": "number",
      "minimum": 5e-324
    },
    "linear_drag_kgps": {
      "type": "number",
      "minimum": 0
    },
    "reaction_torque_per_thrust_m": {
      "type": "number",
      "minimum": 5e-324
    },
    "rate_gains": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 3,
      "maxItems": 3
    },
    "collision_radius_m": {
      "type": "number",
      "minimum": 5e-324
    },
    "gate_pass_margin_m": {
      "type": "number",
      "minimum": 0
    },
    "physics_hz": {
      "type": "integer",
      "const": 120
    },
    "policy_hz": {
      "type": "integer",
      "const": 60
    },
    "geometry_epsilon_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quaternion_input_tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quaternion_min_norm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "motor_roundoff_tolerance_n": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "state_limit_speed_mps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "state_limit_rate_radps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "action": {
      "type": "object",
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "collective-bodyrate-v1"
        },
        "dimension": {
          "type": "integer",
          "const": 4
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "max_collective_n": {
          "type": "number"
        },
        "max_body_rates_radps": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "schema_id",
        "dimension",
        "minimum",
        "maximum",
        "max_collective_n",
        "max_body_rates_radps"
      ],
      "additionalProperties": false
    },
    "rotors": {
      "type": "array",
