              "type": "integer",
              "const": 2
            },
            "position_m": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "reaction_sign": {
              "type": "number"
            }
          },
          "required": [
            "index",
            "position_m",
            "reaction_sign"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "const": 3
            },
            "position_m": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "reaction_sign": {
              "type": "number"
            }
          },
          "required": [
            "index",
            "position_m",
            "reaction_sign"
          ],
          "additionalProperties": false
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
