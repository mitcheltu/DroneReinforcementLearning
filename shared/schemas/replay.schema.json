    "episode_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "env_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "task_kind": {
      "enum": [
        "hover",
        "race"
      ]
    },
    "curriculum_stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "reward_mode": {
      "enum": [
        "reliability",
        "speed"
      ]
    },
    "transition_start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "transition_end": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy_revision_start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "policy_revision_end": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "checkpoint_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "actor_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "revision",
          "actor_sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 2700
    },
    "deterministic_actions": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean"
    },
    "interruption_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "simulator_id": {
      "const": "quadrotor-rk4-v1"
    },
    "controller_id": {
      "const": "rate-p-v1"
    },
    "observation_schema_id": {
      "const": "obs-bodyrate-v1"
    },
    "action_schema_id": {
      "const": "collective-bodyrate-v1"
    },
    "vehicle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
