    "policy_hz": {
      "const": 60
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "duration_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 45
    },
    "files": {
      "type": "object",
      "properties": {
        "course.json": {
          "type": "object",
          "properties": {
            "byte_length": {
              "type": "integer",
