{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aerorl:schema:replay:v1",
  "title": "AeroRL replay v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "replay_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origin": {
      "enum": [
        "training",
        "evaluation",
        "reference",
        "browser"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
