    "policy_hz",
    "created_utc",
    "duration_s",
    "files",
    "outcome"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "interruption_reason": {
            "type": "null"
          },
          "outcome": {
            "not": {
              "enum": [
                "incomplete",
                "user_abort"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "outcome": {
            "enum": [
              "incomplete",
              "user_abort"
            ]
          },
          "interruption_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  ]
